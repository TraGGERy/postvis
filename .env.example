# ========================================================
# POSTVIS ENVIRONMENT CONFIGURATION (CHEAP / ZERO-COST)
# ========================================================

# 1. Zero-Cost JSON Database (Enabled by default, no PostgreSQL server needed!)
USE_JSON_DB="true"
JSON_DB_PATH="./data/db.json"

# 2. Clerk Authentication (Free tier - 10,000 MAU)
# Get your real API keys at https://dashboard.clerk.com -> API Keys
# (If left empty or unconfigured, the app runs in zero-cost Demo Creator mode)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# 3. AI Writing & Social Media Integrations (MuAPI)
# Get your key at https://muapi.app
MUAPIAPP_API_KEY=""

# 4. Optional: Stripe Credit Pack Billing (Leave empty if not charging users)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
